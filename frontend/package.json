{
  "name": "lolfm-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "reference:generate": "node scripts/generate-real-match-reference.mjs",
    "reference:check": "node scripts/generate-real-match-reference.mjs --check",
    "reference:verify": "node scripts/verify-real-match-ui-contract.mjs",
    "live:verify": "node scripts/verify-real-match-live-contract.mjs",
    "player-draft:verify": "node --experimental-strip-types scripts/verify-player-draft-contract.mjs",
    "series:verify": "node --experimental-strip-types scripts/verify-series-contract.mjs",
    "league:verify": "node --experimental-strip-types scripts/verify-league-contract.mjs",
    "bundle:verify": "node scripts/verify-real-match-bundle.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
